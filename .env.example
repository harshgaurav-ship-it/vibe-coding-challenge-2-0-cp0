MONGODB_URI=mongodb+srv://<database-user>:<password>@<cluster-host>/
MONGODB_DB=fieldhouse_demo
AUTH_SECRET=replace-with-a-private-random-secret-of-at-least-32-characters

# Demo seeding is opt-in and only accepts a database name containing "demo".
FIELDHOUSE_SEED_DEMO=false
DEMO_COACH_EMAIL=coach@demo.fieldhouse.test
DEMO_COACH_PASSWORD=replace-with-a-private-password-of-at-least-12-characters
DEMO_SCOUT_EMAIL=scout@demo.fieldhouse.test
DEMO_SCOUT_PASSWORD=replace-with-a-private-password-of-at-least-12-characters
DEMO_PLAYER_EMAIL=aarav@demo.fieldhouse.test
DEMO_PLAYER_PASSWORD=replace-with-a-private-password-of-at-least-12-characters
